# =============================================================================
# Credenciales y Configuración de Oracle Cloud (OCI)
# =============================================================================
# Puedes encontrar estos datos en la consola web de OCI:
# - tenancy_ocid: Perfil -> Tenancy: <nombre> -> OCID
# - user_ocid: Perfil -> User Settings -> OCID
# - fingerprint: Perfil -> User Settings -> API Keys -> Fingerprint
# - private_key_path: Ruta a tu llave privada descargada (.pem)
# =============================================================================

tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
user_ocid        = "ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1" # O tu región asignada (ej. us-phoenix-1, sa-saopaulo-1)

compartment_ocid = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # En cuentas personales suele ser el mismo tenancy_ocid

# Llave SSH pública de tu máquina local para acceder al servidor (cat ~/.ssh/id_rsa.pub o id_ed25519.pub)
ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI..."

# =============================================================================
# Especificaciones de la Instancia (OCI Always Free: Ampere A1 Flex)
# =============================================================================
instance_shape          = "VM.Standard.A1.Flex"
instance_ocpus          = 2    # Nivel gratuito permite hasta 4
instance_memory_in_gbs  = 8    # Nivel gratuito permite hasta 24
boot_volume_size_in_gbs = 50   # Nivel gratuito incluye hasta 200 GB
availability_domain_index = 0
