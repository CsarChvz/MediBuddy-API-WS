# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO MEDIBUDDY API (LOCAL / DESARROLLO)
# ==============================================================================

# Puerto HTTP del servidor Spring Boot
PORT=8080

# --- Base de Datos PostgreSQL (Docker Compose) ---
POSTGRES_DB=meddibuddy
POSTGRES_USER=meddibuddy
POSTGRES_PASSWORD=meddibuddy_password
POSTGRES_PORT=5432
DB_HOST=localhost

# Conexión directa JDBC para Spring Boot al usar PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meddibuddy
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=meddibuddy
SPRING_DATASOURCE_PASSWORD=meddibuddy_password

# --- Seguridad y Tokens Maestros ---
# Clave maestra para autenticar el microcontrolador ESP-32
MEDDIBUDDY_API_KEY=meddibuddy-secret-esp32-key-2026

# Token secreto maestro para clientes móviles Android
MEDDIBUDDY_JWT_SECRET=meddibuddy-jwt-secret-android-token-2026

# --- Opciones de Base de Datos y JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
H2_CONSOLE_ENABLED=true
LOG_LEVEL_MEDIBUDDY=DEBUG

# --- Herramienta Visual pgAdmin (Opcional, puerto 5050) ---
PGADMIN_EMAIL=admin@meddibuddy.com
PGADMIN_PASSWORD=admin1234
PGADMIN_PORT=5050

# --- URLs de Conexión para la Aplicación Móvil Android ---
MEDIBUDDY_API_URL=http://10.0.2.2:8080/
MEDIBUDDY_WS_URL=ws://10.0.2.2:8080/ws/events
